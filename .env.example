# Security & Access Control (Optional)
# Set API_KEY to require authentication on all /api/* routes via x-api-key, Authorization: Bearer, or ?api_key=
API_KEY=

# Set ALLOWED_ORIGINS to lock CORS strictly to your website domains (comma-separated)
# e.g.: ALLOWED_ORIGINS=https://myfrontend.com,https://player.myfrontend.com
ALLOWED_ORIGINS=

# Metadata (Optional: fallback will use Wikidata + Cinemeta if omitted)
TMDB_API_KEY=

# Server Configuration
PORT=3000
HOST=0.0.0.0
